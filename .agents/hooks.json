{
  "ivv-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python ../scripts/guard_ivv_pipeline.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "configuration-baseline-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "python ../scripts/guard_configuration_baseline.py",
        "timeout": 10
      }
    ]
  },
  "cognitive-hud-guard": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python ../scripts/guard_preinvocation_hud.py",
        "timeout": 5
      }
    ]
  }
}
